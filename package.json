{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"gallery": "node scripts/gallery.ts",
		"predev": "npm run gallery && npm run asic",
		"dev": "vite dev",
		"prebuild": "npm run gallery && npm run asic",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"precheck": "npm run gallery && npm run asic",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"asic": "node scripts/asic.ts"
	},
	"devDependencies": {
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"@types/three": "^0.186.0",
		"exifr": "^7.1.3",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"three": "^0.186.1",
		"typescript": "^6.0.3",
		"vite": "^8.3.4"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
